# ── OSINT Surface Analyzer — .env.example ─────────────────────────────────────
#
# INSTRUCCIONES DE SEGURIDAD:
#
# 1. Genera un OSINT_DEPLOY_SECRET ÚNICO para tu instalación:
#       openssl rand -hex 32
#    Copia el resultado como valor de OSINT_DEPLOY_SECRET.
#    ⚠ NUNCA cambies este valor después del primer deploy —
#      cambiarlo invalida todas las API keys almacenadas.
#
# 2. Las API keys se pueden ingresar de DOS formas:
#    a) Via este .env (solo en el PRIMER inicio — se importan al store
#       encriptado y se borran del entorno automáticamente)
#    b) Via la interfaz web en /settings/keys (recomendado para operación normal)
#
# 3. El archivo apikeys.enc en el volumen osint-scans está cifrado con:
#    AES-128-CBC (Fernet) + PBKDF2-HMAC-SHA256 (600 000 iteraciones)
#    Solo puede descifrarse con el OSINT_DEPLOY_SECRET correcto.
#
# 4. NUNCA commitees este archivo con valores reales al repositorio.
#    Agrégalo a .gitignore.

# ── REQUERIDO: secreto de despliegue ──────────────────────────────────────────
# Genera con: openssl rand -hex 32
OSINT_DEPLOY_SECRET=

# ── API Keys (opcional — se pueden ingresar desde la UI) ──────────────────────
# Una vez importadas, estas variables se borran del entorno del container.

HUNTER_API_KEY=
HIBP_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
INTELX_API_KEY=

# ── Tunnel (solo si usas docker-compose.cf-tunnel.yml o ngrok.yml) ────────────
# Cloudflare Tunnel token (opcional — sin token se genera URL temporal)
CLOUDFLARE_TUNNEL_TOKEN=

# Ngrok auth token (requerido para docker-compose.ngrok.yml)
NGROK_AUTHTOKEN=
